// BookMeBot schema v1.
//
// Conventions
// - Table and column names are snake_case in Postgres (@map / @@map) so the
//   hand-written SQL in migrations reads naturally.
// - All instants are `timestamptz` and stored in UTC. Local time only exists
//   at the edges (rendering, parsing customer input) using Business.timezone.
// - Weekly opening hours are stored as minutes-from-local-midnight, which is
//   the only representation that survives DST transitions cleanly.
//
// Things Prisma cannot express live in prisma/migrations as raw SQL:
// - the btree_gist extension
// - EXCLUDE constraints that make double-booking impossible at the DB level
// - the trigger that mirrors booking time ranges onto booking_resources

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy root
// ---------------------------------------------------------------------------

model Business {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  slug               String   @unique
  /// IANA zone, e.g. "Europe/Bucharest". Every local-time calculation uses this.
  timezone           String   @default("Europe/Bucharest")
  /// Slot step when generating bookable times (minutes).
  slotGranularityMin Int      @default(15) @map("slot_granularity_min")
  /// Earliest a customer may book, relative to "now" (minutes).
  minLeadMin         Int      @default(60) @map("min_lead_min")
  /// Furthest into the future a customer may book (days).
  maxAdvanceDays     Int      @default(60) @map("max_advance_days")
  /// Meta phone_number_id that routes inbound WhatsApp traffic to this business.
  whatsappPhoneNumberId String? @unique @map("whatsapp_phone_number_id")
  /// Deposits are refunded only when the customer cancels at least this many hours before the start. 0 = always refund.
  refundCutoffHours  Int      @default(24) @map("refund_cutoff_hours")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  staff                 Staff[]
  resources             Resource[]
  services              Service[]
  customers             Customer[]
  bookings              Booking[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  users                 User[]
  messages              Message[]
  conversations         Conversation[]
  payments              Payment[]
  calendarConnections   CalendarConnection[]
  calendarBlocks        CalendarBlock[]

  @@map("businesses")
}

enum UserRole {
  OWNER
  STAFF

  @@map("user_role")
}

/// Dashboard login. Single-tenant for the demo: one owner per business, but the
/// businessId is on the row so multi-tenant is a data change, not a schema one.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Things that can be booked
// ---------------------------------------------------------------------------

model Staff {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services              ServiceStaff[]
  bookings              Booking[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  calendarConnection    CalendarConnection?
  calendarBlocks        CalendarBlock[]

  @@index([businessId])
  @@map("staff")
}

enum ResourceType {
  CHAIR
  ROOM
  BAY
  STATION

  @@map("resource_type")
}

/// A physical thing a booking occupies in addition to a staff member
/// (barber chair, treatment room, service bay).
model Resource {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  name       String
  type       ResourceType
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings BookingResource[]

  @@index([businessId, type])
  @@map("resources")
}

model Service {
  id                   String        @id @default(uuid()) @db.Uuid
  businessId           String        @map("business_id") @db.Uuid
  name                 String
  durationMin          Int           @map("duration_min")
  priceCents           Int           @map("price_cents")
  currency             String        @default("RON")
  /// Time to keep free before the appointment (setup).
  bufferBeforeMin      Int           @default(0) @map("buffer_before_min")
  /// Time to keep free after the appointment (cleanup).
  bufferAfterMin       Int           @default(0) @map("buffer_after_min")
  /// If set, a booking must also reserve one free resource of this type.
  requiredResourceType ResourceType? @map("required_resource_type")
  /// Deposit collected at booking time; 0 means none.
  depositCents         Int           @default(0) @map("deposit_cents")
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    ServiceStaff[]
  bookings Booking[]

  @@index([businessId])
  @@map("services")
}

/// Which staff members can perform which service.
model ServiceStaff {
  serviceId String @map("service_id") @db.Uuid
  staffId   String @map("staff_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@map("service_staff")
}

// ---------------------------------------------------------------------------
// Availability
// ---------------------------------------------------------------------------

/// Weekly recurring opening window. staffId null = business-wide hours.
/// A staff member is available at time T only if both the business rule and
/// (when present) their own rule cover T.
model AvailabilityRule {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  staffId    String? @map("staff_id") @db.Uuid
  /// 0 = Sunday ... 6 = Saturday (JS Date.getDay convention)
  weekday    Int
  /// Minutes from local midnight, inclusive start.
  startMin   Int     @map("start_min")
  /// Minutes from local midnight, exclusive end. 24*60 = end of day.
  endMin     Int     @map("end_min")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, weekday])
  @@map("availability_rules")
}

/// One-off exception for a specific local date: closed all day, or custom hours.
/// Overrides win over weekly rules for that date.
model AvailabilityOverride {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  staffId    String?  @map("staff_id") @db.Uuid
  /// Local calendar date (no time, no zone).
  date       DateTime @db.Date
  closed     Boolean  @default(true)
  startMin   Int?     @map("start_min")
  endMin     Int?     @map("end_min")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
  @@map("availability_overrides")
}

// ---------------------------------------------------------------------------
// Customers and bookings
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// E.164, e.g. +40721000000. Unique per business, not globally.
  phone      String
  name       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  messages     Message[]
  conversation Conversation?

  @@unique([businessId, phone])
  @@map("customers")
}

enum BookingStatus {
  /// Slot is held (e.g. awaiting deposit). Counts as occupied until holdExpiresAt.
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("booking_status")
}

enum BookingSource {
  DASHBOARD
  WHATSAPP
  SIMULATOR
  API

  @@map("booking_source")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  serviceId     String        @map("service_id") @db.Uuid
  staffId       String        @map("staff_id") @db.Uuid
  status        BookingStatus @default(CONFIRMED)
  source        BookingSource @default(DASHBOARD)
  /// Appointment start/end in UTC. Buffers are NOT included; the engine
  /// applies them when computing free slots.
  startsAt      DateTime      @map("starts_at") @db.Timestamptz
  endsAt        DateTime      @map("ends_at") @db.Timestamptz
  /// For PENDING bookings: when the hold lapses if not confirmed.
  holdExpiresAt DateTime?     @map("hold_expires_at") @db.Timestamptz
  notes         String?
  /// Optimistic concurrency token for dashboard edits.
  version       Int           @default(1)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer          @relation(fields: [customerId], references: [id])
  service   Service           @relation(fields: [serviceId], references: [id])
  staff     Staff             @relation(fields: [staffId], references: [id])
  resources     BookingResource[]
  payment       Payment?
  calendarEvent CalendarEvent?

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

/// Resources occupied by a booking. startsAt/endsAt/active are copies of the
/// parent booking maintained by a DB trigger so the EXCLUDE constraint on this
/// table can guard resource double-booking without a join.
model BookingResource {
  bookingId  String   @map("booking_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz
  endsAt     DateTime @map("ends_at") @db.Timestamptz
  active     Boolean  @default(true)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id])

  @@id([bookingId, resourceId])
  @@index([resourceId, startsAt])
  @@map("booking_resources")
}

// ---------------------------------------------------------------------------
// Inbound webhooks (phase 2). One layer for WhatsApp, payments and calendar.
// ---------------------------------------------------------------------------

/// One HTTP delivery from a provider, stored raw before anything else happens.
/// Kept even when the signature fails, so bad traffic can be inspected.
model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  provider       String
  rawBody        String   @map("raw_body")
  headers        Json
  signatureValid Boolean  @map("signature_valid")
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz

  events InboundEvent[]

  @@index([provider, receivedAt])
  @@map("webhook_deliveries")
}

enum InboundEventStatus {
  /// Persisted, not yet attempted.
  RECEIVED
  /// Claimed by a worker.
  PROCESSING
  PROCESSED
  /// Handler said "nothing to do" (e.g. business rule rejected it).
  SKIPPED
  /// Transient failure, will be retried at next_attempt_at.
  FAILED
  /// Waiting for a sibling event (out-of-order delivery), retried like FAILED.
  DEFERRED
  /// Gave up. Inspect and replay by hand.
  DEAD

  @@map("inbound_event_status")
}

/// One logical event extracted from a delivery (a delivery may carry several).
/// (provider, provider_event_id) is unique: redelivery is a no-op.
model InboundEvent {
  id              String             @id @default(uuid()) @db.Uuid
  deliveryId      String             @map("delivery_id") @db.Uuid
  provider        String
  providerEventId String             @map("provider_event_id")
  eventType       String             @map("event_type")
  /// Groups related events (a payment id, a chat thread, a booking ref) so an
  /// event that arrived early can be re-run when its sibling lands.
  correlationKey  String?            @map("correlation_key")
  payload         Json
  status          InboundEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  nextAttemptAt   DateTime?          @map("next_attempt_at") @db.Timestamptz
  lastError       String?            @map("last_error")
  /// What the handler produced, for inspection and for siblings to read.
  result          Json?
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([status, nextAttemptAt])
  @@index([provider, correlationKey])
  @@map("inbound_events")
}

// ---------------------------------------------------------------------------
// Messaging channels (phase 4). WhatsApp and the built-in simulator share one
// message log so the dashboard and the conversation layer do not care which.
// ---------------------------------------------------------------------------

enum Channel {
  WHATSAPP
  SIMULATOR

  @@map("channel")
}

enum MessageDirection {
  IN
  OUT

  @@map("message_direction")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  businessId        String           @map("business_id") @db.Uuid
  customerId        String           @map("customer_id") @db.Uuid
  channel           Channel
  direction         MessageDirection
  /// text | buttons | list | button_reply | list_reply | unsupported
  kind              String
  /// Human-readable body (or the chosen option's title for replies).
  text              String?
  /// Channel-specific detail: button ids, list rows, raw message for unsupported kinds.
  payload           Json?
  /// Provider's message id (WhatsApp wamid); unique per channel when present.
  providerMessageId String?          @map("provider_message_id")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([channel, providerMessageId])
  @@index([customerId, createdAt])
  @@index([businessId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Conversations (phase 5). One per customer per business: the LLM transcript
// (neutral format, provider-independent) and the small state the guardrails
// need (pending proposal, turn counter, bot/human mode).
// ---------------------------------------------------------------------------

enum ConversationMode {
  BOT
  HUMAN

  @@map("conversation_mode")
}

model Conversation {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  customerId String           @unique @map("customer_id") @db.Uuid
  mode       ConversationMode @default(BOT)
  /// Turn[] in src/server/conversation/llm/types.ts, trimmed to the last N turns.
  transcript Json             @default("[]")
  /// { turn: number, proposal?: {...} } - see conversation/state.ts
  state      Json             @default("{}")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, updatedAt])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// Payments (phase 6). One deposit per booking, collected via Stripe Checkout
// in test mode; refunded on cancel. Provider events arrive through the
// webhook layer.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  /// Checkout created, customer has not paid. Booking is PENDING (held).
  REQUIRES_PAYMENT
  PAID
  /// Cancel happened; refund requested but not yet confirmed by Stripe.
  REFUND_PENDING
  REFUNDED
  /// Checkout expired or hold lapsed before payment.
  EXPIRED
  FAILED
  /// Customer cancelled inside the refund cutoff: deposit kept.
  FORFEITED

  @@map("payment_status")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @map("business_id") @db.Uuid
  bookingId         String        @unique @map("booking_id") @db.Uuid
  provider          String        @default("stripe")
  amountCents       Int           @map("amount_cents")
  currency          String
  status            PaymentStatus @default(REQUIRES_PAYMENT)
  checkoutSessionId String?       @unique @map("checkout_session_id")
  checkoutUrl       String?       @map("checkout_url")
  paymentIntentId   String?       @unique @map("payment_intent_id")
  chargeId          String?       @map("charge_id")
  refundId          String?       @map("refund_id")
  lastError         String?       @map("last_error")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Calendar sync (phase 7). One external calendar per business. Bookings are
// pushed as events; foreign events are pulled as blocks the engine treats as
// busy time.
// ---------------------------------------------------------------------------

/// One per business (staffId null: the shared calendar) and optionally one per
/// staff member. A booking goes to its staff member's calendar when there is
/// one, else to the business calendar. Uniqueness of the business-level row is
/// a partial index in the migration (NULLs are distinct in Postgres).
model CalendarConnection {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  staffId      String?   @unique @map("staff_id") @db.Uuid
  /// "google" or "fake" (local demo)
  provider     String
  calendarId   String    @default("primary") @map("calendar_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  /// Google incremental-sync token for the pull side.
  syncToken    String?   @map("sync_token")
  lastPulledAt DateTime? @map("last_pulled_at") @db.Timestamptz
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  events   CalendarEvent[]
  blocks   CalendarBlock[]

  @@index([businessId])
  @@map("calendar_connections")
}

enum CalendarSyncStatus {
  SYNCED
  FAILED
  DELETED

  @@map("calendar_sync_status")
}

/// The external event that mirrors one booking, and which booking version it reflects.
model CalendarEvent {
  id              String             @id @default(uuid()) @db.Uuid
  bookingId       String             @unique @map("booking_id") @db.Uuid
  connectionId    String             @map("connection_id") @db.Uuid
  externalEventId String             @map("external_event_id")
  syncedVersion   Int                @map("synced_version")
  status          CalendarSyncStatus @default(SYNCED)
  lastError       String?            @map("last_error")
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

/// Time blocked in an external calendar. From the business calendar: busy for
/// everyone. From a staff calendar (staffId set): busy for that person only.
model CalendarBlock {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  staffId         String?  @map("staff_id") @db.Uuid
  externalEventId String   @map("external_event_id")
  startsAt        DateTime @map("starts_at") @db.Timestamptz
  endsAt          DateTime @map("ends_at") @db.Timestamptz
  summary         String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  staff      Staff?             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([businessId, startsAt])
  @@map("calendar_blocks")
}
