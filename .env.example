# Copy to .env for local development. Never commit .env.

# --- Database -----------------------------------------------------------------
# Local Docker Postgres (docker compose up -d). Both URLs are the same locally.
DATABASE_URL="postgresql://bookmebot:bookmebot@localhost:5433/bookmebot?schema=public"
DIRECT_URL="postgresql://bookmebot:bookmebot@localhost:5433/bookmebot?schema=public"

# Supabase (hosted). Two different URLs matter:
#   DATABASE_URL -> Transaction pooler, port 6543, add ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   -> Session pooler, port 5432 on the *pooler* host (IPv4 works).
# The "direct" db.<ref>.supabase.co:5432 host is IPv6-only on the free tier and
# is unreachable from GitHub Actions and most home networks.
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Internal secrets ---------------------------------------------------------
# Bearer token for /api/cron/* and /api/admin/* (Vercel Cron sends CRON_SECRET as
# "Authorization: Bearer ..."). Any long random string locally.
CRON_SECRET="dev-cron-secret-change-me-0000"
# HMAC-SHA256 key the simulator provider signs webhook bodies with.
WEBHOOK_SIMULATOR_SECRET="dev-simulator-secret-change-me"

# --- Auth ---------------------------------------------------------------------
# Auth.js signing secret: openssl rand -base64 32
AUTH_SECRET="dev-auth-secret-change-me-at-least-32-chars"
# Dashboard owner created by `pnpm db:seed` (login: owner@frizeria.demo).
SEED_OWNER_PASSWORD="demo-password"

# Set to 1 to skip env validation (e.g. during `next build` in CI without secrets).
# SKIP_ENV_VALIDATION=1
